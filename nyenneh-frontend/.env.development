# Requests go through the Vite proxy in dev (see vite.config.ts), so a relative
# base URL is enough and avoids CORS entirely.
VITE_API_BASE_URL=/api

# Registry WhatsApp line for the "How to apply" dialog: country code + digits,
# no "+" or spaces. Replace with the real number.
VITE_WHATSAPP_NUMBER=231770000000
