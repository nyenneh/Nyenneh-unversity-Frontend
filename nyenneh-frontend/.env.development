# Requests go through the Vite proxy in dev (see vite.config.ts), so a relative
# base URL is enough and avoids CORS entirely.
VITE_API_BASE_URL=/api

# The contact details the public site publishes — the general inbox and the
# switchboard. Placeholders, the same ones src/content/contact.ts falls back
# to; replace both with the university's published contacts.
VITE_CONTACT_EMAIL=tomnnyenneh@gmai..com
VITE_CONTACT_PHONE=+231778539915

# The same switchboard line as a WhatsApp number for the "How to apply"
# dialog: country code + digits, no "+" or spaces.
VITE_WHATSAPP_NUMBER=231778539915
