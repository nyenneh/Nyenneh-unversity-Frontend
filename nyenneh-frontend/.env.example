VITE_API_BASE_URL=/api

# The two details the public site publishes as "contact us": the general inbox
# and the switchboard. They are what the footer, the contact section and the
# contact page show, and where the enquiry forms address their mail.
VITE_CONTACT_EMAIL=tomnnyenneh@gmail.com
VITE_CONTACT_PHONE=+231778539915

# The same switchboard line as a WhatsApp number, for the "How to apply"
# dialog: country code + digits, no "+" or spaces (this is the format wa.me
# expects). Leave it empty if the university has no WhatsApp line — the forms
# then offer email instead.
VITE_WHATSAPP_NUMBER=231778539915
